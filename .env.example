# ─────────────────────────────────────────────
#  ElevateBox Voice Agent — Environment Config
#  Copy this file to .env and fill in all values
#  NEVER commit .env to version control
# ─────────────────────────────────────────────

# ── Application ──────────────────────────────
APP_ENV=production                        # production | development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BASE_URL=https://your-domain.up.railway.app  # public URL (ngrok or Railway)
WEBHOOK_SECRET=generate-a-strong-random-secret-here

# ── Target Lead ──────────────────────────────
TARGET_PHONE_NUMBER=+918688664337         # number to call (E.164 format)
DEVELOPER_PHONE_NUMBER=+91XXXXXXXXXX     # your number (shown in WhatsApp)
DEVELOPER_NAME=Your Name

# ── Exotel (Telephony) ───────────────────────
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_ACCOUNT_SID=your_exotel_account_sid
EXOTEL_SUBDOMAIN=api.exotel.com           # or your regional subdomain
EXOTEL_CALLER_ID=+91XXXXXXXXXX           # your Exotel Exophone (+91 number)

# ── Vapi (Voice Orchestration) ───────────────
VAPI_API_KEY=your_vapi_api_key
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id
VAPI_WEBHOOK_SECRET=your_vapi_webhook_secret

# ── OpenAI (LLM) ─────────────────────────────
OPENAI_API_KEY=sk-your_openai_api_key
OPENAI_MODEL=gpt-4o

# ── Sarvam AI (STT + TTS) ────────────────────
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_STT_MODEL=saaras:v2
SARVAM_TTS_MODEL=bulbul:v1

# ── ElevenLabs (TTS fallback) ────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID_HINDI=your_hindi_voice_id
ELEVENLABS_VOICE_ID_TELUGU=your_telugu_voice_id
ELEVENLABS_VOICE_ID_ENGLISH=your_english_voice_id

# ── Meta WhatsApp Cloud API ───────────────────
WHATSAPP_ACCESS_TOKEN=your_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
WHATSAPP_API_VERSION=v20.0

# ── Google Calendar ───────────────────────────
GOOGLE_CALENDAR_ID=primary
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# OR path to the service account key file:
# GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/service_account.json

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# For Railway Redis:
# REDIS_URL=redis://default:password@host:port/0

# ── Assets (publicly accessible URLs) ─────────
RESUME_PDF_URL=https://your-domain.com/assets/resume.pdf
ARCHITECTURE_IMAGE_URL=https://your-domain.com/assets/architecture.png

# ── Rate Limiting ─────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── Logging ───────────────────────────────────
LOG_LEVEL=INFO                            # DEBUG | INFO | WARNING | ERROR
